# Production Environment Variables Example
# Copy this file to .env and customize for your deployment

# REQUIRED: Change this to a strong, random secret key for production
SECRET_KEY=your-super-secret-production-key-here-change-me

# Application port (should match docker-compose.yml)
PORT=56133

# Flask environment
FLASK_ENV=production

# Optional: Custom paths for development/testing
# LOG_DIR=./logs
# PORTS_FILE=./ports_data/ports.json

# Docker container specific paths (used in production)
# LOG_DIR=/usr/src/app/logs
# PORTS_FILE=/usr/src/app/ports_data/ports.json